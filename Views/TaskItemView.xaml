<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:TaskFlow.Models"
             xmlns:viewmodels="clr-namespace:TaskFlow.ViewModels"
             x:Class="TaskFlow.Views.TaskItemView"
             x:DataType="models:TaskItem">

    <!--  Task Card  -->
    <Border Margin="0,0,0,10"
            Padding="16"
            BackgroundColor="{AppThemeBinding Light={StaticResource White},
                                              Dark={StaticResource CardBackgroundColor}}"
            Stroke="{AppThemeBinding Light={StaticResource Gray200},
                                     Dark={StaticResource BorderColor}}"
            StrokeShape="RoundRectangle 16"
            StrokeThickness="1">

        <Grid ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="14"
              RowDefinitions="Auto,Auto,Auto,Auto"
              RowSpacing="0">

            <!--  Status Circle  -->
            <Border Grid.Row="0"
                    Grid.RowSpan="3"
                    Grid.Column="0"
                    HeightRequest="42"
                    WidthRequest="42"
                    StrokeShape="RoundRectangle 21"
                    StrokeThickness="1.5"
                    VerticalOptions="Start"
                    Margin="0,2,0,0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TaskListViewModel}}, Path=ToggleTaskStatusCommand}" CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>
                <Border.Triggers>
                    <DataTrigger Binding="{Binding Status}" TargetType="Border" Value="ToDo">
                        <Setter Property="BackgroundColor" Value="Transparent" />
                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource BorderColor}}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" TargetType="Border" Value="InProgress">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource GlassColor}}" />
                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource BorderColor}}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" TargetType="Border" Value="Completed">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource PrimaryTextColor}}" />
                        <Setter Property="Stroke" Value="Transparent" />
                    </DataTrigger>
                </Border.Triggers>
                <Label FontSize="17"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center">
                    <Label.Triggers>
                        <DataTrigger Binding="{Binding Status}" TargetType="Label" Value="ToDo">
                            <Setter Property="Text" Value="&#x25CB;" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource SecondaryTextColor}}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" TargetType="Label" Value="InProgress">
                            <Setter Property="Text" Value="&#x25D0;" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource PrimaryTextColor}}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" TargetType="Label" Value="Completed">
                            <Setter Property="Text" Value="&#x2713;" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PageBackgroundColor}}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Border>

            <!--  Row 0: Title + action buttons  -->
            <Label Grid.Row="0"
                   Grid.Column="1"
                   FontAttributes="Bold"
                   FontFamily="Inter"
                   FontSize="15"
                   LineBreakMode="TailTruncation"
                   MaxLines="2"
                   Text="{Binding Title}"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource PrimaryTextColor}}" />

            <!-- Action buttons: expand + delete -->
            <HorizontalStackLayout Grid.Row="0"
                                   Grid.Column="2"
                                   Spacing="2"
                                   VerticalOptions="Center">

                <!-- Edit -->
                <Border WidthRequest="32"
                        HeightRequest="32"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="Transparent"
                        Stroke="Transparent">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TaskListViewModel}}, Path=ViewTaskCommand}" CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>
                    <Label Text="&#x270E;"
                           FontSize="14"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource SecondaryTextColor}}" />
                </Border>

                <!-- Expand/collapse (only visible when has subtasks) -->
                <Border WidthRequest="32"
                        HeightRequest="32"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="Transparent"
                        Stroke="Transparent"
                        IsVisible="{Binding SubTasks.Count, Converter={StaticResource IntToBoolConverter}}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TaskListViewModel}}, Path=ToggleExpandCommand}" CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>
                    <Label FontSize="14"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource SecondaryTextColor}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="True">
                                <Setter Property="Text" Value="&#x25B4;" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="False">
                                <Setter Property="Text" Value="&#x25BE;" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>

                <!-- Delete -->
                <Border WidthRequest="32"
                        HeightRequest="32"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="Transparent"
                        Stroke="Transparent">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TaskListViewModel}}, Path=DeleteTaskCommand}" CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>
                    <Path Aspect="Uniform"
                          Data="{StaticResource IconClose}"
                          Fill="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource SecondaryTextColor}}"
                          HeightRequest="12"
                          WidthRequest="12"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Border>
            </HorizontalStackLayout>

            <!--  Row 1: Status badge + subtask progress  -->
            <HorizontalStackLayout Grid.Row="1"
                                   Grid.Column="1"
                                   Grid.ColumnSpan="2"
                                   Spacing="6"
                                   Margin="0,4,0,0">
                <!-- Status pill -->
                <Border StrokeShape="RoundRectangle 6"
                        Padding="8,3"
                        StrokeThickness="0">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="ToDo">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource GlassColor}}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="InProgress">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource GlassColor}}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Completed">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource GlassColor}}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="{Binding StatusDisplay}"
                           FontFamily="Inter"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource SecondaryTextColor}}" />
                </Border>

                <!-- Subtask progress pill -->
                <Border StrokeShape="RoundRectangle 6"
                        Padding="8,3"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource GlassColor}}"
                        IsVisible="{Binding SubTasks.Count, Converter={StaticResource IntToBoolConverter}}">
                    <Label FontFamily="Inter"
                           FontSize="11"
                           FontAttributes="Bold"
                           Text="{Binding SubTaskProgress}"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource SecondaryTextColor}}" />
                </Border>
            </HorizontalStackLayout>

            <!--  Row 2: Due Date  -->
            <Label Grid.Row="2"
                   Grid.Column="1"
                   Grid.ColumnSpan="2"
                   FontFamily="Inter"
                   FontSize="11"
                   Margin="0,4,0,0"
                   IsVisible="{Binding DueDate, Converter={StaticResource NullableToBoolConverter}}"
                   Text="{Binding DueDateDisplay}">
                <Label.Triggers>
                    <DataTrigger Binding="{Binding IsOverdue}" TargetType="Label" Value="True">
                        <Setter Property="TextColor" Value="{StaticResource OverdueColor}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsOverdue}" TargetType="Label" Value="False">
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource SecondaryTextColor}}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <!--  Row 3: Expandable subtask panel  -->
            <VerticalStackLayout Grid.Row="3"
                                 Grid.Column="1"
                                 Grid.ColumnSpan="2"
                                 IsVisible="{Binding IsExpanded}"
                                 Spacing="0"
                                 Margin="0,10,0,2">

                <!-- Divider -->
                <BoxView HeightRequest="1"
                         Margin="0,0,0,10"
                         BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource BorderColor}}" />

                <!-- Subtask rows -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding SubTasks}" Spacing="2">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:SubTaskItem">
                            <VerticalStackLayout Spacing="1">

                                <!-- Top-level subtask row -->
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Padding="0,4">
                                    <Border Grid.Column="0"
                                            WidthRequest="28"
                                            HeightRequest="28"
                                            StrokeShape="RoundRectangle 14"
                                            StrokeThickness="1.5"
                                            VerticalOptions="Center">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TaskListViewModel}}, Path=ToggleSubTaskInListCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsCompleted}" Value="False">
                                                <Setter Property="BackgroundColor" Value="Transparent" />
                                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource BorderColor}}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsCompleted}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource PrimaryTextColor}}" />
                                                <Setter Property="Stroke" Value="Transparent" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="&#x2713;"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="False">
                                                    <Setter Property="IsVisible" Value="False" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                                                    <Setter Property="IsVisible" Value="True" />
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PageBackgroundColor}}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>

                                    <Label Grid.Column="1"
                                           Text="{Binding Title}"
                                           FontFamily="Inter"
                                           FontSize="13"
                                           VerticalOptions="Center"
                                           LineBreakMode="TailTruncation">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TaskListViewModel}}, Path=ToggleSubTaskInListCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Label.GestureRecognizers>
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="False">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource PrimaryTextColor}}" />
                                                <Setter Property="TextDecorations" Value="None" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource SecondaryTextColor}}" />
                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>

                                <!-- Child sub-subtask rows (indented) -->
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Children}"
                                                     Margin="38,0,0,0"
                                                     Spacing="0">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:SubTaskItem">
                                            <Grid ColumnDefinitions="Auto,*"
                                                  ColumnSpacing="8"
                                                  Padding="0,3">
                                                <Border Grid.Column="0"
                                                        WidthRequest="22"
                                                        HeightRequest="22"
                                                        StrokeShape="RoundRectangle 11"
                                                        StrokeThickness="1.5"
                                                        VerticalOptions="Center">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TaskListViewModel}}, Path=ToggleSubTaskInListCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding IsCompleted}" Value="False">
                                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource BorderColor}}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Border" Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource SecondaryTextColor}}" />
                                                            <Setter Property="Stroke" Value="Transparent" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <Label Text="&#x2713;"
                                                           FontSize="9"
                                                           FontAttributes="Bold"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="False">
                                                                <Setter Property="IsVisible" Value="False" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="IsVisible" Value="True" />
                                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PageBackgroundColor}}" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </Border>

                                                <Label Grid.Column="1"
                                                       Text="{Binding Title}"
                                                       FontFamily="Inter"
                                                       FontSize="12"
                                                       VerticalOptions="Center"
                                                       LineBreakMode="TailTruncation">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TaskListViewModel}}, Path=ToggleSubTaskInListCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    </Label.GestureRecognizers>
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="False">
                                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource SecondaryTextColor}}" />
                                                            <Setter Property="TextDecorations" Value="None" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource SecondaryTextColor}}" />
                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Tap to open full edit -->
                <Label Text="Edit task for more options &#x2192;"
                       FontFamily="Inter"
                       FontSize="11"
                       Margin="0,8,0,0"
                       TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource SecondaryTextColor}}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TaskListViewModel}}, Path=ViewTaskCommand}" CommandParameter="{Binding .}" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>

        </Grid>
    </Border>
</ContentView>
