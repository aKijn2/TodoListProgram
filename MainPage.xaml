<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TaskFlow.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:TaskFlow.Models"
    xmlns:viewmodels="clr-namespace:TaskFlow.ViewModels"
    xmlns:views="clr-namespace:TaskFlow.Views"
    Title="{Binding Title}"
    x:DataType="viewmodels:TaskListViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource White},
                                      Dark={StaticResource PageBackgroundColor}}"
    Shell.NavBarIsVisible="False">

    <Grid BackgroundColor="{AppThemeBinding Light={StaticResource White},
                                            Dark={StaticResource PageBackgroundColor}}">

        <!-- ═══════════════════════════════════════════════════════ -->
        <!--  WINDOWS LAYOUT: 2-column sidebar + content            -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid x:Name="WindowsLayout" ColumnDefinitions="280,*">

            <!-- Left Sidebar -->
            <views:SidebarView Grid.Column="0" />

            <!-- Right Content Area -->
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">

                <views:MainHeaderView Grid.Row="0" Margin="0" />

                <Border Grid.Row="1"
                        Margin="40,10,40,20"
                        Padding="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource White},
                                                          Dark={StaticResource CardBackgroundColor}}"
                        HeightRequest="46"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200},
                                                 Dark={StaticResource BorderColor}}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="1">
                    <Grid Padding="15,0" ColumnDefinitions="Auto,*">
                        <Path Grid.Column="0"
                              Aspect="Uniform"
                              Data="{StaticResource IconSearch}"
                              Fill="{AppThemeBinding Light={StaticResource Black},
                                                     Dark={StaticResource PrimaryTextColor}}"
                              HeightRequest="16"
                              VerticalOptions="Center"
                              WidthRequest="16" />
                        <Entry Grid.Column="1"
                               Margin="10,0,0,0"
                               FontFamily="Inter"
                               FontSize="14"
                               Placeholder="Search tasks..."
                               PlaceholderColor="{AppThemeBinding Light={StaticResource Gray600},
                                                                  Dark={StaticResource SecondaryTextColor}}"
                               Text="{Binding SearchText}"
                               TextColor="{AppThemeBinding Light={StaticResource Black},
                                                           Dark={StaticResource PrimaryTextColor}}"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Padding="40,0,40,40">
                    <views:EmptyStateView />
                    <ScrollView IsVisible="{Binding HasTasks}" VerticalScrollBarVisibility="Always">
                        <StackLayout Padding="0,0,0,40" Spacing="32">
                            <VerticalStackLayout IsVisible="{Binding TodayTasks.Count, Converter={StaticResource IntToBoolConverter}}" Spacing="16">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleTodayCommand}" />
                                    </Grid.GestureRecognizers>
                                    <Label FontAttributes="Bold" FontFamily="Inter" FontSize="20" Text="Today"
                                           TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource PrimaryTextColor}}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1" FontSize="12" Text="▼"
                                           TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource PrimaryTextColor}}"
                                           VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger Binding="{Binding IsTodayExpanded}" TargetType="Label" Value="False">
                                                <Setter Property="Rotation" Value="-90" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                                <CollectionView IsVisible="{Binding IsTodayExpanded}" ItemsSource="{Binding TodayTasks}" SelectionMode="None">
                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:TaskItem">
                                            <views:TaskItemView />
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>

                            <VerticalStackLayout IsVisible="{Binding UpcomingTasks.Count, Converter={StaticResource IntToBoolConverter}}" Spacing="16">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleUpcomingCommand}" />
                                    </Grid.GestureRecognizers>
                                    <Label FontAttributes="Bold" FontFamily="Inter" FontSize="20" Text="Coming Up"
                                           TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource PrimaryTextColor}}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1" FontSize="12" Text="▼"
                                           TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource PrimaryTextColor}}"
                                           VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger Binding="{Binding IsUpcomingExpanded}" TargetType="Label" Value="False">
                                                <Setter Property="Rotation" Value="-90" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                                <CollectionView IsVisible="{Binding IsUpcomingExpanded}" ItemsSource="{Binding UpcomingTasks}" SelectionMode="None">
                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:TaskItem">
                                            <views:TaskItemView />
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </StackLayout>
                    </ScrollView>
                </Grid>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!--  ANDROID LAYOUT: single column, top bar, FAB, bottom tabs -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid x:Name="AndroidLayout"
              IsVisible="False"
              RowDefinitions="Auto,Auto,*,Auto">

            <!-- Top App Bar -->
            <Grid Grid.Row="0"
                  Padding="16,48,16,12"
                  ColumnDefinitions="*,Auto"
                  BackgroundColor="{AppThemeBinding Light={StaticResource White},
                                                    Dark={StaticResource CardBackgroundColor}}">
                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                    <Label FontAttributes="Bold"
                           FontFamily="Inter"
                           FontSize="24"
                           Text="TaskFlow"
                           TextColor="{AppThemeBinding Light={StaticResource Black},
                                                       Dark={StaticResource PrimaryTextColor}}" />
                    <Label FontFamily="Inter"
                           FontSize="12"
                           Text="Let's be productive today"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600},
                                                       Dark={StaticResource SecondaryTextColor}}" />
                </VerticalStackLayout>
                <!-- Settings icon button -->
                <Border Grid.Column="1"
                        HeightRequest="40"
                        WidthRequest="40"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100},
                                                          Dark={StaticResource GlassColor}}"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleSettingsCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="⚙"
                           FontSize="20"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Black},
                                                       Dark={StaticResource PrimaryTextColor}}" />
                </Border>
            </Grid>

            <!-- Search Bar -->
            <Border Grid.Row="1"
                    Margin="16,8,16,8"
                    Padding="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White},
                                                      Dark={StaticResource CardBackgroundColor}}"
                    HeightRequest="48"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200},
                                             Dark={StaticResource BorderColor}}"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="1">
                <Grid Padding="14,0" ColumnDefinitions="Auto,*">
                    <Path Grid.Column="0"
                          Aspect="Uniform"
                          Data="{StaticResource IconSearch}"
                          Fill="{AppThemeBinding Light={StaticResource Gray500},
                                                 Dark={StaticResource SecondaryTextColor}}"
                          HeightRequest="18"
                          VerticalOptions="Center"
                          WidthRequest="18" />
                    <Entry Grid.Column="1"
                           Margin="10,0,0,0"
                           FontFamily="Inter"
                           FontSize="15"
                           Placeholder="Search tasks..."
                           PlaceholderColor="{AppThemeBinding Light={StaticResource Gray500},
                                                              Dark={StaticResource SecondaryTextColor}}"
                           Text="{Binding SearchText}"
                           TextColor="{AppThemeBinding Light={StaticResource Black},
                                                       Dark={StaticResource PrimaryTextColor}}"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Task List -->
            <Grid Grid.Row="2" Padding="0">
                <views:EmptyStateView />
                <ScrollView IsVisible="{Binding HasTasks}" VerticalScrollBarVisibility="Never">
                    <StackLayout Padding="16,4,16,100" Spacing="24">

                        <!-- TODAY -->
                        <VerticalStackLayout IsVisible="{Binding TodayTasks.Count, Converter={StaticResource IntToBoolConverter}}" Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" Padding="4,0">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleTodayCommand}" />
                                </Grid.GestureRecognizers>
                                <Label FontAttributes="Bold"
                                       FontFamily="Inter"
                                       FontSize="16"
                                       Text="Today"
                                       TextColor="{AppThemeBinding Light={StaticResource Black},
                                                                   Dark={StaticResource PrimaryTextColor}}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       FontSize="11"
                                       Text="▼"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500},
                                                                   Dark={StaticResource SecondaryTextColor}}"
                                       VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger Binding="{Binding IsTodayExpanded}" TargetType="Label" Value="False">
                                            <Setter Property="Rotation" Value="-90" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                            <CollectionView IsVisible="{Binding IsTodayExpanded}"
                                            ItemsSource="{Binding TodayTasks}"
                                            SelectionMode="None">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:TaskItem">
                                        <views:TaskItemView />
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>

                        <!-- COMING UP -->
                        <VerticalStackLayout IsVisible="{Binding UpcomingTasks.Count, Converter={StaticResource IntToBoolConverter}}" Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" Padding="4,0">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleUpcomingCommand}" />
                                </Grid.GestureRecognizers>
                                <Label FontAttributes="Bold"
                                       FontFamily="Inter"
                                       FontSize="16"
                                       Text="Coming Up"
                                       TextColor="{AppThemeBinding Light={StaticResource Black},
                                                                   Dark={StaticResource PrimaryTextColor}}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       FontSize="11"
                                       Text="▼"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500},
                                                                   Dark={StaticResource SecondaryTextColor}}"
                                       VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger Binding="{Binding IsUpcomingExpanded}" TargetType="Label" Value="False">
                                            <Setter Property="Rotation" Value="-90" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                            <CollectionView IsVisible="{Binding IsUpcomingExpanded}"
                                            ItemsSource="{Binding UpcomingTasks}"
                                            SelectionMode="None">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:TaskItem">
                                        <views:TaskItemView />
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>

                    </StackLayout>
                </ScrollView>

                <!-- Floating Action Button -->
                <Border HorizontalOptions="End"
                        VerticalOptions="End"
                        Margin="0,0,20,20"
                        HeightRequest="56"
                        WidthRequest="56"
                        StrokeShape="RoundRectangle 28"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Black},
                                                          Dark={StaticResource PrimaryTextColor}}"
                        StrokeThickness="0"
                        ZIndex="10">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AddTaskCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="+"
                           FontSize="28"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource White},
                                                       Dark={StaticResource PageBackgroundColor}}" />
                </Border>
            </Grid>

            <!-- Bottom Filter Tab Bar -->
            <!-- Use Grid+BoxView instead of Border so we avoid invalid StrokeThickness multi-value -->
            <Grid Grid.Row="3"
                  RowDefinitions="1,Auto"
                  BackgroundColor="{AppThemeBinding Light={StaticResource White},
                                                    Dark={StaticResource CardBackgroundColor}}">

                <!-- Top separator line -->
                <BoxView Grid.Row="0"
                         Color="{AppThemeBinding Light={StaticResource Gray200},
                                                 Dark={StaticResource BorderColor}}"
                         HeightRequest="1" />

                <!-- Tab buttons -->
                <Grid Grid.Row="1"
                      ColumnDefinitions="*,*,*,*"
                      ColumnSpacing="0"
                      Padding="8,4,8,8">

                    <!-- All -->
                    <Border Grid.Column="0" Padding="8,10" BackgroundColor="Transparent"
                            Stroke="Transparent" StrokeShape="RoundRectangle 10">
                        <Border.Triggers>
                            <DataTrigger Binding="{Binding SelectedFilterIndex}" TargetType="Border" Value="0">
                                <Setter Property="BackgroundColor" Value="#20808080" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LoadTasksCommand}" CommandParameter="0" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="3">
                            <Label Text="◆" FontSize="18" HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource SecondaryTextColor}}">
                                <Label.Triggers>
                                    <DataTrigger Binding="{Binding SelectedFilterIndex}" TargetType="Label" Value="0">
                                        <Setter Property="TextColor" Value="{StaticResource Black}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="All" FontSize="10" FontFamily="Inter" HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource SecondaryTextColor}}">
                                <Label.Triggers>
                                    <DataTrigger Binding="{Binding SelectedFilterIndex}" TargetType="Label" Value="0">
                                        <Setter Property="TextColor" Value="{StaticResource Black}" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                    </Border>

                    <!-- To Do -->
                    <Border Grid.Column="1" Padding="8,10" BackgroundColor="Transparent"
                            Stroke="Transparent" StrokeShape="RoundRectangle 10">
                        <Border.Triggers>
                            <DataTrigger Binding="{Binding SelectedFilterIndex}" TargetType="Border" Value="1">
                                <Setter Property="BackgroundColor" Value="#20808080" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LoadTasksCommand}" CommandParameter="1" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="3">
                            <Label Text="○" FontSize="18" HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource SecondaryTextColor}}">
                                <Label.Triggers>
                                    <DataTrigger Binding="{Binding SelectedFilterIndex}" TargetType="Label" Value="1">
                                        <Setter Property="TextColor" Value="{StaticResource Black}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="To Do" FontSize="10" FontFamily="Inter" HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource SecondaryTextColor}}">
                                <Label.Triggers>
                                    <DataTrigger Binding="{Binding SelectedFilterIndex}" TargetType="Label" Value="1">
                                        <Setter Property="TextColor" Value="{StaticResource Black}" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                    </Border>

                    <!-- In Progress -->
                    <Border Grid.Column="2" Padding="8,10" BackgroundColor="Transparent"
                            Stroke="Transparent" StrokeShape="RoundRectangle 10">
                        <Border.Triggers>
                            <DataTrigger Binding="{Binding SelectedFilterIndex}" TargetType="Border" Value="2">
                                <Setter Property="BackgroundColor" Value="#20808080" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LoadTasksCommand}" CommandParameter="2" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="3">
                            <Label Text="◑" FontSize="18" HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource SecondaryTextColor}}">
                                <Label.Triggers>
                                    <DataTrigger Binding="{Binding SelectedFilterIndex}" TargetType="Label" Value="2">
                                        <Setter Property="TextColor" Value="{StaticResource Black}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="Progress" FontSize="10" FontFamily="Inter" HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource SecondaryTextColor}}">
                                <Label.Triggers>
                                    <DataTrigger Binding="{Binding SelectedFilterIndex}" TargetType="Label" Value="2">
                                        <Setter Property="TextColor" Value="{StaticResource Black}" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Done -->
                    <Border Grid.Column="3" Padding="8,10" BackgroundColor="Transparent"
                            Stroke="Transparent" StrokeShape="RoundRectangle 10">
                        <Border.Triggers>
                            <DataTrigger Binding="{Binding SelectedFilterIndex}" TargetType="Border" Value="3">
                                <Setter Property="BackgroundColor" Value="#20808080" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LoadTasksCommand}" CommandParameter="3" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="3">
                            <Label Text="●" FontSize="18" HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource SecondaryTextColor}}">
                                <Label.Triggers>
                                    <DataTrigger Binding="{Binding SelectedFilterIndex}" TargetType="Label" Value="3">
                                        <Setter Property="TextColor" Value="{StaticResource Black}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="Done" FontSize="10" FontFamily="Inter" HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource SecondaryTextColor}}">
                                <Label.Triggers>
                                    <DataTrigger Binding="{Binding SelectedFilterIndex}" TargetType="Label" Value="3">
                                        <Setter Property="TextColor" Value="{StaticResource Black}" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                    </Border>

                </Grid>
            </Grid>
        </Grid>

        <!--  SETTINGS OVERLAY (both platforms)  -->
        <views:SettingsOverlayView />

        <!--  DELETE CONFIRMATION OVERLAY (both platforms)  -->
        <views:DeleteConfirmationView ZIndex="999" />
    </Grid>
</ContentPage>